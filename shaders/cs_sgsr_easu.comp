#version 460
#extension GL_GOOGLE_include_directive : require
#include "easu_interface.h"
#include "sgsr1.h"

vec3 upscale(ivec2 pos, vec2 srcSize, vec2 dstSize)
{
    return sampleSgsr1(s_samplers[0], (vec2(pos) + 0.5) / dstSize).rgb;
}
