void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy) - origin;
    if (p.x < 0 || p.y < 0 || p.x >= cols * 16 || p.y >= lines * 18) return;
    int line = p.y / 18, col = p.x / 16;
    uint ch = chars[line * cols + col] & 127u;
    ivec2 gp = ivec2(p.x % 16, p.y % 18) / 2;   // 18 px par ligne : 16 de glyphe + 2 d'interligne
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    vec4 c = imageLoad(dst, at);
    if (ch == 0u) return;
    c.rgb *= 0.35;
    if (gp.y < 8) {
        uint row = gp.y < 4 ? (FONT[ch].x >> (8 * gp.y)) : (FONT[ch].y >> (8 * (gp.y - 4)));
        if (((row >> gp.x) & 1u) != 0u) c.rgb = vec3(1.0, 0.95, 0.3);
    }
    imageStore(dst, at, c);
}
