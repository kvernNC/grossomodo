#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
// Écran final : gauche = méthode A, droite = méthode B (trait blanc au partage), loupe (zoom > 1, pixels nets).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D imgA;
layout(binding = 1) uniform sampler2D imgB;
layout(binding = 2, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform PC { ivec2 size; int split; int zoom; vec2 center; };
void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;
    if (split > 0 && p.x == split) { imageStore(dst, p, vec4(1.0)); return; }
    vec2 q = vec2(p) + 0.5;
    if (zoom > 1) {
        // chaque moitié est agrandie autour de son propre centre (même zone de l'image des deux côtés)
        vec2 c = center;
        if (split > 0) c.x = (p.x < split ? 0.5 : 1.5) * float(split);
        vec2 world = center + (q - c) / float(zoom);
        q = world;
    }
    ivec2 t = clamp(ivec2(q), ivec2(0), size - 1);
    vec3 col = (split > 0 && p.x < split) ? texelFetch(imgA, t, 0).rgb : texelFetch(imgB, t, 0).rgb;
    imageStore(dst, p, vec4(col, 1.0));
}
