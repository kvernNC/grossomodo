#version 450
// SPDX-License-Identifier: GPL-3.0-or-later
#extension GL_GOOGLE_include_directive : require
// FSR 1 RCAS (netteté, AMD FidelityFX, MIT). con.x = 0 : copie sans netteté.
layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform PC { uvec4 con; };
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return AF4(texelFetch(src, p, 0)); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"
void pass(uvec2 pos)
{
    if (any(greaterThanEqual(pos, uvec2(imageSize(dst))))) return;
    vec3 c;
    if (con.y == 0u) c = texelFetch(src, ivec2(pos), 0).rgb;
    else FsrRcasF(c.r, c.g, c.b, pos, con);
    imageStore(dst, ivec2(pos), vec4(c, 1.0));
}
void main()
{
    uvec2 pos = ARmp8x8(gl_LocalInvocationID.x) + uvec2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    pass(pos); pos.x += 8u; pass(pos); pos.y += 8u; pass(pos); pos.x -= 8u; pass(pos);
}
